# Copia este ficheiro para `.env` e preenche os valores.
# O `.env` nunca vai para o Git (ver .gitignore).

# Ligacao a base de dados local de desenvolvimento.
DATABASE_URL="postgresql://postgres:TUA_SENHA@localhost:5432/bolsa360_dev?schema=public"

# Porta HTTP da API local.
PORT=3000

# Palavras-passe das contas de demonstracao criadas pelo seeder (npm run db:seed).
# Usa valores proprios: cada pessoa usa as suas. Nunca reutilizar uma BD partilhada.
SEED_ADMIN_PASSWORD="define-uma-senha-aqui"
SEED_DEMO_PASSWORD="define-uma-senha-aqui"
